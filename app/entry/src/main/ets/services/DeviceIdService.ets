/**
 * Stable device identity for the relay's push registry.
 *
 * The relay must be able to reach this phone after the app is closed, so it
 * stores the Push Token against a key that survives reconnects and reinstalls.
 * A display name cannot serve as that key — it is the same string on every
 * install, so two phones would overwrite each other's token.
 *
 * Primary source: `deviceInfo.ODID` (Open Device Identifier). It is a
 * developer-level identifier that needs no permission, and is stable across
 * app reinstalls (it is only regenerated by a factory reset, or by uninstalling
 * every app from this developer). `deviceInfo.udid` would be more permanent but
 * requires the restricted permission `ohos.permission.sec.ACCESS_UDID`, which
 * is another ACL approval we do not need.
 *
 * Fallback: a random id persisted in preferences, used only if ODID is
 * unavailable. That fallback is lost on reinstall, which is acceptable — the
 * next hello simply registers a new entry and the stale one expires.
 */
import { deviceInfo } from '@kit.BasicServicesKit';
import { preferences } from '@kit.ArkData';
import { hilog } from '@kit.PerformanceAnalysisKit';
import type { common } from '@kit.AbilityKit';

const DOMAIN = 0x0000;
const TAG = 'DeviceId';
const STORE = 'dsh_identity';
const KEY = 'deviceId';

export class DeviceIdService {
  private static deviceId: string = '';

  /** Last resolved id (empty before init completes). */
  static get(): string {
    return DeviceIdService.deviceId;
  }

  /** Prefix an ODID so the source is obvious in relay logs. */
  private static fromOdid(): string {
    try {
      const odid: string = deviceInfo.ODID;
      if (odid && odid.length > 0) {
        return `odid-${odid}`;
      }
    } catch (e) {
      // Reading ODID should not fail, but never let identity break startup.
    }
    return '';
  }

  /** Read or create the persisted fallback id. */
  private static async loadFallback(context: common.UIAbilityContext): Promise<string> {
    const store = await preferences.getPreferences(context, { name: STORE });
    const stored = store.getSync(KEY, '') as string;
    if (stored && stored.length > 0) {
      return stored;
    }
    const generated = `gen-${Math.random().toString(36).slice(2)}${Date.now().toString(36)}`;
    store.putSync(KEY, generated);
    await store.flush();
    hilog.info(DOMAIN, TAG, 'fallback device id created');
    return generated;
  }

  /**
   * Resolve the device id once. Call before the relay connects so the very
   * first hello already carries it.
   */
  static async init(context: common.UIAbilityContext): Promise<void> {
    if (DeviceIdService.deviceId.length > 0) {
      return;
    }
    let id = DeviceIdService.fromOdid();
    if (id.length === 0) {
      try {
        id = await DeviceIdService.loadFallback(context);
      } catch (e) {
        // Last resort: an in-memory id. Push still works, it just cannot be
        // recognised as the same device after a restart.
        id = `mem-${Date.now().toString(36)}`;
        hilog.warn(DOMAIN, TAG, 'fallback id unavailable, using in-memory id');
      }
    }
    DeviceIdService.deviceId = id;
    hilog.info(DOMAIN, TAG, 'device id resolved: %{public}s', id);
  }
}

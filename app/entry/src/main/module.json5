{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // Push Kit：client_id 必须写字面量，不能用 $string: 资源引用
    // 取值 = AGC「增长 → 推送服务 → 选择应用」中该应用的 Client ID
    "metadata": [
      {
        "name": "client_id",
        "value": "6917616843236218365"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        // 已移除 "backgroundModes": ["dataTransfer"]：不再用长时任务常驻后台，
        // 离线送达改由 Push Kit 负责。恢复后台保活时需连同
        // ohos.permission.KEEP_BACKGROUND_RUNNING 一起加回。
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home",
              // Push Kit 必需：声明本 ability 接收推送投递。
              // 只允许一个 ability 定义该 action；actions 与 uris 不可同处一个对象。
              "action.ohos.push.listener"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ]
  }
}
